# ═══════════════════════════════════════════════════════════════
# Omni Code — data/ 完全禁止 HTTP 存取
# ═══════════════════════════════════════════════════════════════
# 這個目錄放的是 config.json（可能含 API 金鑰）、會話存檔、
# 背景命令輸出與記憶檔案 —— 任何情況都不該由瀏覽器直接取得。
# 一切讀寫只能經由 api/*.php 端點。
# ═══════════════════════════════════════════════════════════════

# ─── Apache 2.4 ────────────────────────────────────────────────
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# ─── Apache 2.2 後備 ───────────────────────────────────────────
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
